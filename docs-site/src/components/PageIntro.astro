---
// Starlight's title slot. The title itself now lives on the lab sheet (SheetHeader); this
// slot keeps what sits on the bench above the sheet, plus page behaviors.
import BenchmarkExplorerBehavior from './BenchmarkExplorerBehavior.astro';
import ArchitectureFlowBehavior from './ArchitectureFlowBehavior.astro';
import BenchmarkTabs from './BenchmarkTabs.astro';

const { id } = Astro.locals.starlightRoute;
---
{(id === 'dashboard' || id.startsWith('dashboard/')) && <BenchmarkTabs />}
{id.startsWith('dashboard/') && <BenchmarkExplorerBehavior />}
{id === 'operations' && <ArchitectureFlowBehavior />}
