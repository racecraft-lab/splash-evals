---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import ProjectLockup from './ProjectLockup.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<footer class="reader-footer">
  <div class="footer-identity">
    <div class="footer-lockups"><SiteTitle /><ProjectLockup compact /></div>
    <p>Local tests. Clear evidence. Stated limits.</p>
  </div>
  <nav aria-label="Further reading">
    <a href={`${base}/dashboard/`}>Results</a>
    <a href={`${base}/methodology/`}>How we tested</a>
    <a href={`${base}/sources/`}>Sources</a>
    <a href="https://github.com/racecraft-lab/splash-evals">Source code</a>
  </nav>
</footer>
