---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import ProjectLockup from './ProjectLockup.astro';
import ThemeSelect from './ThemeSelect.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = Astro.url.pathname.replace(/\/$/, '');
const items = [
  { label: 'Overview', route: '' },
  { label: 'Results', route: '/dashboard' },
  { label: 'How we tested', route: '/methodology' },
  { label: 'Run it yourself', route: '/operations' },
  { label: 'Sources', route: '/sources' },
];
---
<div class="site-header">
  <div class="identity"><SiteTitle /><ProjectLockup /></div>
  <nav aria-label="Main navigation" class="primary-nav">
    {items.map(({ label, route }) => {
      const exact = current === `${base}${route}`;
      return <a href={`${base}${route}/`} aria-current={exact ? 'page' : undefined}>{label}</a>;
    })}
  </nav>
  <div class="site-utilities"><Search /><ThemeSelect /><a class="github-link" href="https://github.com/racecraft-lab/splash-evals">GitHub</a></div>
</div>
