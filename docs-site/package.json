{
  "name": "splash-evals-docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22.12.0 <27"
  },
  "scripts": {
    "dev": "astro dev",
    "content:generate": "node scripts/generate-content.mjs",
